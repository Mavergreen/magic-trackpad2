<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Mavericks Trackpad 2</title>
    <!-- Welcome pane: explains up front why the installer needs an administrator password (it installs a
         kernel extension). Shown by Installer.app on a direct .pkg install. Lives in dist/resources/ and
         is handed to productbuild via its resources flag. -->
    <welcome file="Welcome.html" mime-type="text/html"/>
    <!-- Conclusion pane: the ONLY surface Installer.app renders after the scripts run, and therefore the
         only place our two install-time messages actually reach a human. postinstall still echoes them,
         but PackageKit sends script stdout to /var/log/install.log, which nobody reads. That is how a
         0.5.4 install silently left the prefpane companion un-injectable (no SIMBL) for weeks. The text is
         STATIC and covers both conditions ("if you were updating", "if you don't already have SIMBL"),
         because Installer's only conditional mechanism is installation-check JS, which can ONLY block the
         install; blocking the driver over a preference-pane prerequisite would be wrong, since the
         trackpad works fine without SIMBL. Asserted by cmake/check_pkg_payload.sh. -->
    <conclusion file="Conclusion.html" mime-type="text/html"/>
    <!--
      HARD install floor: OS X 10.9.5. A SAFETY gate, not a KPI limit. The hijack of
      AppleMultitouchDriver / MultitouchHID.plugin is reverse-engineered against
      10.9.5 offsets, and loading those on an unverified kernel risks a panic. See
      the 2026-07-02 crossbuild design spec (section 2a) and the FLOOR item in
      IDEAS.md before widening this.
    -->
    <allowed-os-versions>
        <os-version min="10.9.5"/>
    </allowed-os-versions>
    <options customize="never" require-scripts="true"/>
    <choices-outline>
        <line choice="default"><line choice="dev.mavergreen.voodooinputmavericks"/></line>
    </choices-outline>
    <choice id="default"/>
    <choice id="dev.mavergreen.voodooinputmavericks" visible="false">
        <pkg-ref id="dev.mavergreen.voodooinputmavericks"/>
    </choice>
    <pkg-ref id="dev.mavergreen.voodooinputmavericks" version="0" onConclusion="none">voodooinputmavericks-component.pkg</pkg-ref>
</installer-gui-script>
