#!/bin/sh
# Pre-push guard: never push a release tag (v*) by hand.
#
# Releases are cut by dispatching .github/workflows/release.yml with release=true from main; shipyard's
# publish-release.yml then mints v<MAVERICKS_VERSION> itself, at the dispatched commit. It refuses a
# tag that already exists (so two runs racing one version rebuild rather than relabel), which means a
# hand-pushed tag publishes nothing -- it only makes the dispatch for that version refuse. Deleting a
# tag (git push origin :refs/tags/vX) is still allowed: that is how you would undo one.
#
# Cutting a release: bump MAVERICKS_VERSION in CMakeLists.txt, optionally commit
# release-notes/v<version>.md, push main, then: gh workflow run release.yml -f release=true
#
# Install once:  git config core.hooksPath .githooks
set -eu

# stdin: <local ref> <local sha> <remote ref> <remote sha> per pushed ref.
while read -r _local_ref local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
    refs/tags/v*)
        case "$local_sha" in *[!0]*) : ;; *) continue ;; esac   # all zeros: a deletion
        tag="${remote_ref#refs/tags/}"
        echo "pre-push: refusing to push release tag $tag -- release.yml mints release tags itself." >&2
        echo "pre-push: bump MAVERICKS_VERSION (release-notes/v<version>.md is optional), push main," >&2
        echo "pre-push: then dispatch: gh workflow run release.yml -f release=true" >&2
        exit 1
        ;;
    esac
done
exit 0
